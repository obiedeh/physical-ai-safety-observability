# Optional HTTPS front door for the Physical AI Safety console (opt-in).
#
# The API keeps serving plain HTTP on port 8081; this unit adds HTTPS on 8444
# so phones and laptops on the LAN can share their camera (browsers only
# allow camera access in a secure context). Make a certificate first:
#
#   .venv/bin/python -m api.local_cert 192.0.2.10 thor.local     # or mkcert
#   cp deploy/physical-ai-safety-tls.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now physical-ai-safety-tls
#
# Then open https://192.0.2.10:8444/ and trust the certificate once.
[Unit]
Description=Physical AI Safety HTTPS front door (TLS proxy to the HTTP API)
After=physical-ai-safety.service
Wants=physical-ai-safety.service

[Service]
WorkingDirectory=%h/github/physical-ai-safety-observability
Environment=PHYSICAL_AI_TLS_LISTEN=0.0.0.0:8444
Environment=PHYSICAL_AI_TLS_TARGET=127.0.0.1:8081
Environment=PHYSICAL_AI_TLS_CERT=%h/.config/physical-ai-safety/tls/cert.pem
Environment=PHYSICAL_AI_TLS_KEY=%h/.config/physical-ai-safety/tls/key.pem
ExecStart=%h/github/physical-ai-safety-observability/.venv/bin/python -m api.tls_proxy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
