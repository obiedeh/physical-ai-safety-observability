# Required for openai-compatible and cosmos-reason2 adapters. Not needed for mock.
COSMOS_API_KEY=your-api-key-here

# Path to runtime config JSON. Omit to use built-in defaults (mock adapter, local SQLite).
# PHYSICAL_AI_CONFIG=configs/local.json

# Uploaded videos ("Uploaded video" camera profile). Files are stored next to the
# SQLite database by default (<db dir>/uploads, gitignored). Limit in bytes, default 2 GiB.
# PHYSICAL_AI_UPLOAD_MAX_BYTES=2147483648
# PHYSICAL_AI_UPLOAD_DIR=

# Optional HTTPS front door for phones and other devices sharing their camera
# (python -m api.tls_proxy, deploy/physical-ai-safety-tls.service). HTTP stays unchanged.
# Make the certificate with: python -m api.local_cert 192.0.2.10 thor.local   (or mkcert)
# PHYSICAL_AI_TLS_LISTEN=0.0.0.0:8444
# PHYSICAL_AI_TLS_TARGET=127.0.0.1:8081
# PHYSICAL_AI_TLS_CERT=~/.config/physical-ai-safety/tls/cert.pem
# PHYSICAL_AI_TLS_KEY=~/.config/physical-ai-safety/tls/key.pem
